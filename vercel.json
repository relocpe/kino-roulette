{
  "version": 2,
  "buildCommand": null,
  "installCommand": null,
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
  { "source": "/((?!api/|js/|css/|data/|fonts/|workers/|icon|apple-touch|manifest|og\\.jpg).*)", "destination": "/404.html" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}